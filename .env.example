DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional TMDB API Read Access Token; never place this in frontend code.
TMDB_API_READ_ACCESS_TOKEN=

# Without EMAIL_HOST, local mail is printed in the runserver console.
# Setting EMAIL_HOST automatically switches delivery to SMTP.
# For Gmail, use an App Password (not your account password).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# DEFAULT_FROM_EMAIL=CineBook <you@example.com>
